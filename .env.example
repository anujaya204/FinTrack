# Copy to .env.docker.local and replace every placeholder.
# Keep your existing .env unchanged. Use --env-file .env.docker.local with Compose.
SECRET_KEY=replace_with_a_random_local_django_secret
# Use letters, numbers, and underscores for the database name and username.
POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_database_user
# Use a long random alphanumeric password so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=replace_with_random_alphanumeric_password
# Compose builds DATABASE_URL with the db hostname; do not set it here.
